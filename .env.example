# ─── Backend ──────────────────────────────────────
UIPATH_TOKEN_URL=https://cloud.uipath.com/identity_/connect/token

# ─── Seguranca ────────────────────────────────────
# Gere um secret unico: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=TROQUE_AQUI

# ─── Banco de Dados (PostgreSQL) ──────────────────
DB_PASSWORD=TROQUE_AQUI
DATABASE_URL=postgresql://robocommand:TROQUE_AQUI@localhost:5432/robocommand

# ─── Frontend (opcional) ──────────────────────────
# So precisa se o backend estiver em outro servidor
# VITE_API_URL=https://api.seudominio.com/api
